# Chunk 1: the app runs without any configured secrets.
# Copy this file to .env.local. Only NEXT_PUBLIC_APP_NAME is used in Chunk 1.
NEXT_PUBLIC_APP_NAME="Focusboard"
APP_TIMEZONE="Asia/Karachi"

# Chunk 2: database connection (leave empty for Chunk 1)
DATABASE_URL=""

# Chunk 3: private dashboard login (leave empty for Chunk 1)
SESSION_SECRET=""
ADMIN_EMAIL=""
ADMIN_PASSWORD_HASH=""

# Chunks 4-5: official WhatsApp Business Cloud API (leave empty for Chunk 1)
WHATSAPP_VERIFY_TOKEN=""
WHATSAPP_APP_SECRET=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_SENDER_ALLOWLIST=""

# Chunk 6: approved template and cron secret (leave empty for Chunk 1)
WHATSAPP_REMINDER_RECIPIENT=""
WHATSAPP_TEMPLATE_NAME=""
WHATSAPP_TEMPLATE_LANGUAGE="en_US"
CRON_SECRET=""
